{
  "name": "@stefanobartoletti/eslint-config",
  "type": "module",
  "version": "6.2.0",
  "packageManager": "pnpm@12.4.2",
  "description": "",
  "author": "Stefano Bartoletti (https://github.com/stefanobartoletti/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanobartoletti/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "config-inspector",
    "release": "pnpm lint && bumpp conventional -r --all",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "eslint": ">=10.10.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/config-inspector": "^3.4.1",
    "bumpp": "^12.3.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7"
  }
}
