  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/config-inspector": "^3.2.0",
    "bumpp": "^12.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "husky": "^9.1.7"
  }
