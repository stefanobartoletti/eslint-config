{
  "name": "@stefanobartoletti/eslint-config",
  "type": "module",
  "version": "6.0.4",
  "packageManager": "pnpm@11.20.0",
  "description": "",
  "author": "Stefano Bartoletti (https://github.com/stefanobartoletti/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanobartoletti/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
